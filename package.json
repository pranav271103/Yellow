{
  "name": "yellow-repo",
  "private": true,
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39",
  "resolutions": {
    "@tauri-apps/api": "2.10.1"
  },
  "scripts": {
    "build": "pnpm --filter yellow-app build",
    "compile": "pnpm --filter yellow-app compile",
    "dev": "pnpm --filter yellow-app dev",
    "dev:app": "pnpm --filter yellow-app dev:app",
    "dev:app:win": "pnpm --filter yellow-app dev:app:win",
    "dev:cef": "pnpm --filter yellow-app dev:cef",
    "format": "pnpm --filter yellow-app format",
    "format:check": "pnpm --filter yellow-app format:check",
    "knip": "pnpm --filter yellow-app knip",
    "knip:production": "pnpm --filter yellow-app knip:production",
    "lint": "pnpm --filter yellow-app lint",
    "lint:fix": "pnpm --filter yellow-app lint:fix",
    "prepare": "husky",
    "postinstall": "husky",
    "tauri": "pnpm --filter yellow-app tauri",
    "test": "pnpm --filter yellow-app test",
    "test:coverage": "pnpm --filter yellow-app test:coverage",
    "test:rust": "pnpm --filter yellow-app test:rust",
    "mock:api": "node scripts/mock-api-server.mjs",
    "mascot:render": "pnpm --dir remotion render:runtime-assets",
    "pr:checklist": "node scripts/check-pr-checklist.mjs",
    "rabbit": "bash scripts/rabbit/cli.sh",
    "review": "bash scripts/review/cli.sh",
    "work": "bash scripts/work/cli.sh",
    "debug": "bash scripts/debug/cli.sh",
    "test:install-ps1": "pwsh -NoProfile -File scripts/tests/YellowWindowsInstall.Tests.ps1",
    "rust:check": "pnpm --filter yellow-app rust:check",
    "typecheck": "pnpm --filter yellow-app compile"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "ws": "^8.20.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1"
  }
}
